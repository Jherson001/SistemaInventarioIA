# Copia este archivo a .env y completa los valores.
# Nunca subas .env real a GitHub.

PORT=5000
JWT_SECRET=cambia_esto_por_un_secreto_largo
JWT_EXPIRES_IN=7d

# MySQL (local XAMPP o Aiven)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=inventorydb
# En Aiven / cloud:
# DB_SSL=true

CORS_ORIGIN=*

# Password inicial del usuario admin@local (solo al CREAR el usuario)
ADMIN_BOOTSTRAP_PASSWORD=123456

# IMPORTANTE (robustez):
# true  = en cada arranque resetea la clave de admin@local (solo para emergencias)
# false = no toca la contraseña (recomendado en producción / Render)
RESET_ADMIN_PASSWORD=false

# IA opcional
# AI_URL=http://localhost:8001
